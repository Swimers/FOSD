# 忽略编译目录
build/

# 忽略 VTK 9.5 的库文件目录
lib/VTK/VTK-Linux-debug/lib/vtk-9.5/
# 忽略 VTK 9.5 的头文件目录
lib/VTK/VTK-Linux-debug/include/vtk-9.5/
# 忽略 Qt Creator 用户配置文件
*.pro.user
*.pro.user.*

# 忽略 AI 编程助手 / Agent 的本地配置与中间产物
# （各工具的本地设置、会话记录、附件缓存等，不应纳入版本管理）
.claude/
.codex/
.cursor/
.windsurf/
.continue/
.cline/
.roo/
.aider*
.gemini/
.qwen/
.mimocode/
.specstory/
.hermes/

# 忽略上述工具可能生成的散落配置文件
.mcp.json

# Private device/model data: retain only the audited QSS resources.
/[Dd][Aa][Tt][Aa]/*
!/[Dd][Aa][Tt][Aa]/[Qq][Ss][Ss]/
!/[Dd][Aa][Tt][Aa]/[Qq][Ss][Ss]/**

# Historical generated copies and unaudited application packages.
/[Bb][Uu][Ii][Ll][Dd]/
/[Bb][Uu][Ll][Ii][Dd]/
/[Rr]elease/FOSD-*.[Zz][Ii][Pp]
/[Rr]elease/FOSD-*.[Zz][Ii][Pp].sha256
