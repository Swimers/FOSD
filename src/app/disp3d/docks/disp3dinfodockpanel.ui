  <layout class="QGridLayout" name="gridLayout">
   <!-- 四项只读统计量。原先用 QRadioButton 承载，但同一父控件下的单选钮
        天然互斥，会让人误以为这四项需要四选一；它们只是字段名，故改为 QLabel。
        左侧字段名右对齐、右侧数值左对齐，形成整齐的两列表格。 -->
   <item row="0" column="0">
    <widget class="QLabel" name="radioButton">
     <property name="text">
      <string>节点数：</string>
     </property>
     <property name="alignment">
      <set>Qt::AlignRight|Qt::AlignVCenter</set>
     </property>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QLabel" name="lab_NumPoints">
     <property name="text">
      <string/>
     </property>
     <property name="alignment">
