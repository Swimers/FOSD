      <string>关键点变形显示</string>
     </property>
    </widget>
   </item>
   <!-- 吸收剩余高度：统计量吸顶、按钮贴底。
        原先这里的弹簧 sizeHint 只有 3px，既推不动任何东西又白占一个网格单元。 -->
   <item row="6" column="0" colspan="2">
