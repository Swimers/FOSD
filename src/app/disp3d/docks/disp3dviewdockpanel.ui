         <string>左侧</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>上方</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>下方</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>正后</string>
        </property>
       </item>
      </widget>
     </item>
    </layout>
   </item>
   <item row="6" column="0" colspan="2">
    <widget class="QPushButton" name="pbtn_SwitchView">
     <property name="text">
      <string>切换视角</string>
     </property>
    </widget>
   </item>
   <item row="7" column="0" colspan="2">
    <spacer name="verticalSpacer_3">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
